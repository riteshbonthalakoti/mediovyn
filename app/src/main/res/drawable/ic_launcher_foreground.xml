<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Hexagonal / Rounded 'M' Emblem Badge -->
    <path
        android:pathData="M34,24 L74,24 C80,24 84,28 84,34 L84,74 C84,80 80,84 74,84 L34,84 C28,84 24,80 24,74 L24,34 C24,28 28,24 34,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="24"
                android:endX="84"
                android:endY="84"
                android:type="linear">
                <item android:offset="0.0" android:color="#7C3AED" />
                <item android:offset="1.0" android:color="#4C1D95" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized 'M' Inner Cutout & Glowing Cyan Play Button -->
    <path
        android:pathData="M38,36 L48,54 L54,44 L60,54 L70,36 L70,72 L62,72 L62,50 L54,64 L46,50 L46,72 L38,72 Z"
        android:fillColor="#050508" />

    <!-- Center Cyan Glow Play Triangle -->
    <path
        android:pathData="M50,48 L64,54 L50,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="48"
                android:endX="64"
                android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#06B6D4" />
                <item android:offset="1.0" android:color="#0891B2" />
            </gradient>
        </aapt:attr>
    </path>
</vector>